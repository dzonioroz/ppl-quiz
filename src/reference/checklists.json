  "emergency": [
    {
      "id": "1",
      "title": "Fire during start on ground",
      "sourcePage": 1,
      "steps": [
        {
          "item": "STARTER",
          "action": "CONTINUE CRANKING"
        },
        {
          "note": "IF ENGINE STARTS:"
        },
        {
          "item": "POWER",
          "action": "1700 RPM 4 MINS"
        },
        {
          "item": "ENGINE",
          "action": "SHUT DOWN"
        },
        {
          "note": "IF ENGINE FAILS TO START:"
        },
        {
          "item": "THROTTLE",
          "action": "FULL OPEN"
        },
        {
          "item": "MIXTURE",
          "action": "CUTOFF"
        },
        {
          "item": "CRANKING",
          "action": "CONTINUE"
        },
        {
          "note": "AFTER 3 MIN"
        },
        {
          "item": "ENGINE",
          "action": "SECURE"
        }
      ]
    },
